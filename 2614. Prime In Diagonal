class Solution {
    public int diagonalPrime(int[][] nums) {
        int n = nums.length;
        int maxPrime = 0;

        for (int i = 0; i < n; i++) 
        {
            int mainDiagonal = nums[i][i];
            if (isPrime(mainDiagonal)) 
            {
                maxPrime = Math.max(maxPrime, mainDiagonal);
            }
            int secondaryDiagonal = nums[i][n - i - 1];
            if (isPrime(secondaryDiagonal)) 
            {
                maxPrime = Math.max(maxPrime, secondaryDiagonal);
            }
        }

        return maxPrime;
    }

    private boolean isPrime(int num) {
        if (num < 2) {
            return false;
        }

        for (int i = 2; i * i <= num; i++) {
            if (num % i == 0) {
                return false;
            }
        }

        return true;
    }
}

import java.util.*;

class Solution {
    public int minimumRightShifts(List<Integer> nums) {
        int n = nums.size();
        int breakCount = 0;
        int breakIndex = -1;

        for (int i = 0; i < n; i++) {
            int next = (i + 1) % n;
            if (nums.get(i) > nums.get(next)) {
                breakCount++;
                breakIndex = i;
            }
        }

        if (breakCount > 1) {
            return -1;
        }

        if (breakCount == 0) {
            return 0;
        }

        return n - (breakIndex + 1);
    }
}

class Solution {
    public int maxVowels(String s, int k) {

        Set<Character> vowel = Set.of('a', 'e', 'i', 'o', 'u');

        int left = 0;
        int cnt = 0;
        int res = 0;

        for (int right = 0; right < s.length(); right++) {

            if (vowel.contains(s.charAt(right))) {
                cnt++;
            }

            if (right - left + 1 > k) {
                if (vowel.contains(s.charAt(left))) {
                    cnt--;
                }
                left++;
            }
            res = Math.max(res, cnt);
        }

        return res;
    }
}

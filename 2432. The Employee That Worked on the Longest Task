class Solution {
    public int hardestWorker(int n, int[][] logs) {
        
        int id = logs[0][0] ;
        int longestHours = logs[0][1] ;
        for(int i = 1 ; i < logs.length ; i++)
        {
            int curWorkerHours = logs[i][1] - logs[i-1][1];
            if(longestHours < curWorkerHours 
            || longestHours == curWorkerHours
            && id > logs[i][0])
            {
                id = logs[i][0] ;
                longestHours = curWorkerHours ;
            }
        }
        return id ;
    }
}

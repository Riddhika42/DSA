class Solution {
    public int numberOfGoodSubarraySplits(int[] nums) {
        
        boolean mandatorySplit = false ;
        int total = 1 ;
        int count = 1 ;
        for(int i = 0 ; i<nums.length ; i++)
        {
            if(nums[i]==1)
            {
                mandatorySplit = true ;
                total = (int)(1l * total * count %100_000_007) ;
                count = 1 ;

            }
            else{
                if(mandatorySplit)
                {
                    count ++ ;
                }
            }
        }

        return mandatorySplit == true ? total : 0 ;
    }
}

class Solution {
    public int[] threeEqualParts(int[] arr) {

        int n = arr.length;

        int ones = 0;

        for (int num : arr) 
        {
            if (num == 1)
             {
                ones++;
            }
        }
        if (ones == 0) 
        {
            return new int[]{0, n - 1};
        }
        if (ones % 3 != 0) 
        {
            return new int[]{-1, -1};
        }

        int k = ones / 3;

        int first = -1;
        int second = -1;
        int third = -1;

        int count = 0;

        for (int i = 0; i < n; i++) 
        {

            if (arr[i] == 1) 
            {
                count++;

                if (count == 1) 
                {
                    first = i;
                }

                if (count == k + 1)
                {
                    second = i;
                }
                if (count == 2 * k + 1)
                {
                    third = i;
                }
            }
        }
        int length = n - third;
        if (first + length > second ||second + length > third)
        {
            return new int[]{-1, -1};
        }
        for (int i = 0; i < length; i++)
         {

            if (arr[first + i] != arr[second + i] ||arr[first + i] != arr[third + i]) 
            {

                return new int[]{-1, -1};
            }
        }
        int i = first + length - 1;
        int j = second + length;

        if (i >= second || j > third) 
        {
            return new int[]{-1, -1};
        }

        return new int[]{i, j};
    }
}

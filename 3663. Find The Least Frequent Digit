class Solution {
    public int getLeastFrequentDigit(int n) 
    {

        int[] freq = new int[10];
        while (n > 0) 
        {
            int digit = n % 10;
            freq[digit]++;
            n = n / 10;
        }

        int ans = 0;
        int minFreq = Integer.MAX_VALUE;
        for (int digit = 0; digit <= 9; digit++) 
        {
            if (freq[digit] > 0 && freq[digit] < minFreq) 
            {
                minFreq = freq[digit];
                ans = digit;
            }
        }

        return ans;
    }
}

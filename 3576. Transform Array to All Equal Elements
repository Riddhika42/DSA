import java.util.Arrays;

class Solution {

    int solve(int[] nums, int target) {
        int cnt = 0;
        int n = nums.length;

        for (int i = 0; i < n - 1; i++) {
            if (nums[i] != target) {
                nums[i] = -nums[i];
                nums[i + 1] = -nums[i + 1];
                cnt++;
            }
        }

        return nums[n - 1] == target ? cnt : Integer.MAX_VALUE;
    }

    public boolean canMakeEqual(int[] nums, int k) {

        int[] copy1 = Arrays.copyOf(nums, nums.length);
        int[] copy2 = Arrays.copyOf(nums, nums.length);

        return solve(copy1, 1) <= k ||
               solve(copy2, -1) <= k;
    }
}

import java.util.*;

class Solution {

    public List<String> generateParenthesis(int n) {

        List<String> result = new ArrayList<>();

        generateValidParenthesis(n, 0, 0, result, "");

        return result;
    }

    public void generateValidParenthesis(int n,int open,int close,List<String> result,String current) 
        
        { 
            if (open == n && close == n) 
            {
                result.add(current);
                return;
            }

        if (open < n)
        {
            generateValidParenthesis( n,open + 1,close,result,current + "(");
        }

        if (close < open) 
        {
            generateValidParenthesis( n,open,close + 1,result,current + ")");
        }
    }
}

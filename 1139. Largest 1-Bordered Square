class Solution {
    public int largest1BorderedSquare(int[][] grid) {
        int m = grid.length;
        int n = grid[0].length;
        int[][] right = new int[m][n];
        int[][] down = new int[m][n];
        for (int i = m - 1; i >= 0; i--)
         {
            for (int j = n - 1; j >= 0; j--)
             {
                if (grid[i][j] == 1) {
                    right[i][j] = 1 + (j + 1 < n ? right[i][j + 1] : 0);
                    down[i][j] = 1 + (i + 1 < m ? down[i + 1][j] : 0);
                }
            }
        }

        int maxSide = 0;
     for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) 
            {

                int possibleSide = Math.min(right[i][j], down[i][j]);

                for (int side = possibleSide; side > maxSide; side--)
                 {
                    int bottomRow = i + side - 1;
                    int rightCol = j + side - 1;

                    if (bottomRow < m && rightCol < n
                            && right[bottomRow][j] >= side
                            && down[i][rightCol] >= side)
                             {
                        maxSide = side;
                        break;
                    }
                }
            }
        }
    return maxSide * maxSide;
    }
}

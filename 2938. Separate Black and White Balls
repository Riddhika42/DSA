class Solution {
    public long minimumSteps(String s) {

        long n = s.length();
        long last = 0 ;
        long swapCount = 0 ;
        for(int cur = 0 ; cur < n ; cur++ )
        {
            if(s.charAt(cur) == '0')
            {
                swapCount +=(cur-last);
                last++;
            }
        }
        return swapCount ;
        
    }
}

class Solution {
    public int deleteAndEarn(int[] nums) {

        int[] sum = new int[10001];

        for (int num : nums)
            sum[num] += num;

        int prev = 0, curr = 0;

        for (int val : sum) {
            int temp = curr;
            curr = Math.max(curr, prev + val);
            prev = temp;
        }

        return curr;
    }
}
